# Copy this file to ".env" (same folder) and fill in your token.
# .env is git-ignored, so your token never ends up on GitHub.

# --- Option A: Hugging Face Inference Providers (cloud, nothing to download)
EVACTIVE_LLM_BACKEND=hf
HF_TOKEN=hf_paste_your_token_here
# Optional: models to try, in order (Evactive also falls back to its own list)
# HF_MODEL=Qwen/Qwen2.5-72B-Instruct

# --- Option B: local Ollama (comment out Option A, uncomment these)
# EVACTIVE_LLM_BACKEND=ollama
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:3b

# --- Saving credits (optional)
# AI text starts OFF (turn it on with the AI switch in the dashboard). To start with it ON:
# EVACTIVE_LLM=1
# Auto-pause when no dashboard is open for N seconds / after N simulated minutes of incident (0 = off):
# EVACTIVE_IDLE_PAUSE_S=60
# EVACTIVE_MAX_INCIDENT_MIN=20
